{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/toootakeooot-bit/tradeplan-engine/tc/schema/tc_tradeplan_raw.schema.json",
  "title": "TCTradePlanRaw",
  "description": "Loss-preserving wrapper for one TradingCursor Native response. It is not TradePlanState and does not perform Question Contract mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_identity",
    "original_response",
    "parse_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "record_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "source_run_id",
        "execution_order",
        "source_raw_artifact"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "source_run_id": {
          "type": "string",
          "minLength": 1
        },
        "execution_order": {
          "type": "integer",
          "minimum": 1
        },
        "source_raw_artifact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "wrapper_metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Metadata added by the wrapper. Never represents TradingCursor-native strategy authority."
    },
    "original_response": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true,
      "description": "Unmodified TradingCursor native response as received at the semantic JSON-value level. Unknown native outer fields are preserved.",
      "properties": {
        "status": {"type": "string"},
        "exchange": {"type": "string"},
        "symbol": {"type": "string"},
        "interval": {"type": "string"},
        "analysis": {},
        "model": {"type": "string"},
        "timestamp": {"type": "string"}
      }
    },
    "parsed_analysis": {
      "type": "object",
      "additionalProperties": true,
      "description": "Lossless structural parse of original_response.analysis. All native keys and values must be retained; no semantic normalization is allowed.",
      "properties": {
        "potentialPosition": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "entryPrice": {"type": "number"},
            "positionType": {"type": "string"},
            "takeProfits": {
              "type": "array",
              "items": {"type": "number"}
            },
            "stopLoss": {"type": "number"}
          }
        },
        "indicatorReadings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "values": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "priceMetrics": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "supportLevels": {
              "type": "array",
              "items": {"type": "number"}
            },
            "current_price": {"type": "number"},
            "resistanceLevels": {
              "type": "array",
              "items": {"type": "number"}
            }
          }
        },
        "futureAssumption": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "trend": {"type": "string"},
            "confidenceScore": {"type": "number"},
            "patternDetected": {"type": "string"}
          }
        },
        "observations": {"type": "string"},
        "action_url": {"type": "string"}
      }
    },
    "derived_metadata": {
      "type": "object",
      "additionalProperties": false,
      "description": "Technical values derived from preserved native content; never represented as native fields.",
      "properties": {
        "chart_id": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "derived_from_pointer",
            "method"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "derived_from_pointer": {
              "type": "string",
              "const": "/parsed_analysis/action_url"
            },
            "method": {
              "type": "string",
              "const": "url_query_parameter:chartId"
            }
          }
        }
      }
    },
    "parse_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["PARSED", "NOT_PARSED", "PARSE_ERROR"]
        },
        "error_message": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "parse_status": {
            "properties": {
              "state": {"const": "PARSED"}
            },
            "required": ["state"]
          }
        }
      },
      "then": {
        "required": ["parsed_analysis"],
        "properties": {
          "original_response": {
            "required": ["analysis"],
            "properties": {
              "analysis": {"type": "string"}
            }
          }
        }
      }
    }
  ]
}
